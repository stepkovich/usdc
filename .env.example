# ============================================================================
# ПРИМЕР ОКРУЖЕНИЯ (unified-real, репо USDC, 3.11).
#
# Как пользоваться:
#   1) скопируйте этот файл в .env  (одна строка: .env не попадает в git);
#   2) заполните значения;
#   3) бот читает .env сам при старте (load_dotenv в bot/config.py).
#
# Правило: всё, что можно, живёт ЗДЕСЬ — не в коде.
# Если параметра нет в .env, бот берёт дефолт из bot/config.py (дефолты
# равны боевым значениям 3.11).
# ============================================================================

# --- Биржа: ключи ------------------------------------------------------------
# Ключ ТОЛЬКО с торговыми правами, БЕЗ права вывода денег, с IP-белым
# списком сервера. Без ключей бот не стартует (ValueError).
API_KEY=
API_SECRET=

# --- Режим -------------------------------------------------------------------
# mainnet = боевой, реальные деньги. (демо/testnet — для лабораторных)
BOT_MODE=mainnet

# Драйв: 0 = реальные ордера; 1 = бот считает, но не шлёт ордера.
BOT_DRY_RUN=0

# --- Telegram: уведомления ---------------------------------------------------
# Сюда прилетают: сделки, часовой отчёт, тревоги, судья.
# Пусто = без уведомлений (бот работает молча).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Буря (ML-5ч) — единственный боевой двигатель ---------------------------
ML5H_ENABLED=1
# вселенная: пусто = все живые USDT-перпетуалы (берутся автоматически
# с биржи, ~515 монет). Через запятую можно задать свой список:
# ML5H_SYMBOLS=BTCUSDT,ETHUSDT
ML5H_SYMBOLS=
# максимум одновременных позиций (v3 02.11: 10 слотов × маржа 5% = 50% пула)
ML5H_MAX_SLOTS=10

# ЗАПАСНОЙ гейт уверенности (0-1). ИСПОЛЬЗУЕТСЯ ТОЛЬКО КОГДА В ПАСПОРТЕ
# МОДЕЛИ (ml5h_meta.json) НЕТ СВОЕГО gate — тогда бот берёт это значение.
# Обычно не трогайте: порог у модели-Бури = 0.65 живёт в самом артефакте,
# чтобы модель и порог не разъезжались.
ML5H_GATE=0.65
# сколько 30-минутных баров держать позицию (10 × 30м = 5 часов)
ML5H_HOLD_BARS=10
# размер бара, на котором считается сигнал (30 = 30-минутные свечи)
ML5H_BAR_MINUTES=30
# сколько баров истории скачать на старте (прогрев признаков)
ML5H_WARMUP_BARS=1000

# --- Сайзинг (схема владельца v3, 02.11) -------------------------------------
# Номинал сделки = баланс × пул(50%) × плечо(3) × доля(10%) = 15% баланса.
# Пол ордера = минимальный ордер МОНЕТЫ × 1.1 (пол снизу, чтобы не упереться).
ML5H_NOTIONAL_PCT=0.10        # доля от плечевой ёмкости пула на сделку
ML5H_MARGIN_POOL_PCT=0.5      # пул = половина всего баланса
ML5H_MIN_NOTIONAL_BUFFER=1.1  # пол = мин-ордер монеты × 1.1
ML5H_LEVERAGE=3               # плечо, которое бот выставляет на каждой монете
# дедлайн входа/выхода в секундах: если мейкер-ордер не взят за это время —
# отменить (вход) / повторить (выход)
ML5H_ENTRY_TTL_S=60
ML5H_EXIT_TTL_S=90
# аварийный стоп: выход по рынку, если цена пробила вход на 15% (флеш-защита)
ML5H_EMERGENCY_STOP_PCT=0.15
# два ключа ниже — legacy старого сайзинга. 0 = не используются
# (работают проценты выше), но можно задать риск/кап в деньгах:
ML5H_RISK_USDC=0
# дневной кап в деньгах: 0 = чистый процент (DAILY_CAP_PCT ниже)
ML5H_DAY_CAP_USDC=0

# ДНЕВНОЙ КАП, % от текущего баланса: если PnL дня хуже этого — новые
# входы на сегодня закрыты (02.11: ~2 стопа в день).
DAILY_CAP_PCT=0.04

# --- Фильтры и второе мнение --------------------------------------------------
# мета-замок (второе мнение): бот спрашивает мета-модель у каждого сигнала;
# при p_win < 0.5 мета ветоит вход. РЕШЕНИЕ ВЛАДЕЛЬЦА 01.11: ВСЕГДА ВКЛ.
ML5H_META=1
# фильтр «тихая треть» (рентген 12.10): сонные монеты (низкая ATR-квантиль)
# мимо. 1 = включить, 0 = выключить.
ML5H_QUIET_FILTER=1
# вход тейкером, если лимитка не взялась за TTL (для демо; в бою не нужно)
ML5H_TAKER_FALLBACK=0

# --- Двигатель «Стакан» (lob): в бою ВЫКЛЮЧЕН (упрощение 27.10) -------------
# Хранится как запасной. Включается только по явному решению.
LOB_ENABLED=0
LOB_SYMBOLS=
LOB_RISK_USDC=0.10
LOB_DAY_CAP_USDC=0.50
