# Копировать в .env и заполнить реальными ключами!
# .env в репозиторий не попадает (.gitignore).

# --- Ключи биржи: только торговые права, БЕЗ права вывода, IP-whitelist ---
API_KEY=ваш_ключ
API_SECRET=ваш_секрет

# Режим: demo | testnet | mainnet  (ДЕМО по умолчанию)
# Боевой запуск: BOT_MODE=mainnet и BOT_DRY_RUN=0
BOT_MODE=demo

# Telegram-уведомления: сделки (вход/тейк/стоп) + отчёт каждый час.
# Пусто = бот работает без уведомлений (не ошибка).
# Токен — от @BotFather, chat_id — числовой ID чата с ботом.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Стратегия
BOT_TARGET_PCT=0.005      # цель одной сделки, доля цены (+0.5%)

# Сайзинг (рейт-нормированный):
# размер = баланс x BOT_RISK_PCT / дистанция стопа, зажат между
# полом (minNotional монеты x BOT_NOTIONAL_BUFFER) и BOT_MAX_NOTIONAL
BOT_RISK_PCT=0.0015       # риск на один сработавший стоп: 0.15% баланса
BOT_MAX_NOTIONAL=1500     # потолок нотионала одной позиции, USDC
BOT_NOTIONAL_BUFFER=1.1   # буфер над minNotional (запас на округления)

# Дневные лимиты убытка (доля баланса), сброс в 00:00 UTC:
# 1) НА НАПРАВЛЕНИЕ — дневной убыток лонгов (или шортов) достиг порога:
#    новые входы этой стороны на паузе до сброса, противоположная сторона
#    продолжает торговать (развороты не пропускает).
# 2) ОБЩИЙ — суммарный дневной убыток достиг порога: полная остановка
#    новых входов до сброса (обе стороны).
BOT_DAILY_LOSS_PCT=0.02         # 2% баланса на направление за день
BOT_TOTAL_DAILY_LOSS_PCT=0.03   # 3% баланса суммарно за день

# Плечо и пробный прогон
BOT_LEVERAGE=20           # изолированное плечо (запас до ликвидации)
BOT_DRY_RUN=1             # 1 = только сигналы в журнал, ордера не ставятся

# Список пар через запятую (пусто = все USDC-пары биржи)
BOT_SYMBOLS=

# ПЕРЕСТАНОВКА: заявка едет за новыми экстремумами, пока ждёт отката.
# Бэктест 25.09 (честная модель): +240% против +19% базы на 1м; на 15м свечах
# — убыточно, НЕ совмещать с BOT_TF_MIN>1.
BOT_REARM=0
# SMC-ФИЛЬТР направления по 15-минутной структуре. Бэктест огромный, но
# живая реализация (скользящее окно) расходится с бэктестной (полная история)
# в 20% решений — в бою дал WR 42% вместо 82%. Выключен до починки.
BOT_SMC_FILTER=0
# РЕЖИМ-ГЕЙТ (walk-forward подтверждён на обоих годах): лонги только когда
# BTC за 30 дней вырос >+3%, шорты — только когда упал >−3%, болото —
# не торгуем. Лучшее улучшение по честной модели.
BOT_REGIME_GATE=1
# ЗЕРНИСТОСТЬ СВЕЧЕЙ: 1 = минутки, 15 = стратегия на 15-минутных свечах
# (подтверждённые пробои; бэктест +12,378% при строжайшей конвенции).
# Свечи агрегируются из минутного потока, история подгружается при старте.
BOT_TF_MIN=1
BOT_DONCHIAN_BARS=480   # окно Дончиана в минутных барах (480 = 8ч)

# Пути (опционально; по умолчанию bot/journal.db и bot/bot.log)
# BOT_JOURNAL_PATH=
# BOT_LOG_PATH=
