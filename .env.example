# ПРИМЕР НАСТРОЕК (env) для единой торговой системы.
# Актуализировано 14.11.2026 — каждый параметр сверён с кодом
# (bot/config.py + main.py + bot/executor.py): читаются ТОЛЬКО
# переменные из этого списка, лишних в коде нет.
#
# КАК ПОЛЬЗОВАТЬСЯ:
#   1. Скопировать этот файл в .env (в git он не попадает).
#   2. Заполнить ключи и Telegram.
#   3. Остальное менять только понимая, зачем.
#
# ВАЖНО ПЕРЕД ЗАПУСКОМ НА НОВОМ СЕРВЕРЕ:
#   - ключ биржи должен иметь право ТОЛЬКО на торговлю (без вывода)
#     и только с адресом ЭТОГО сервера в белом списке;
#   - кроме .env в папку data/models/ положить 4 файла моделей
#     (ml5h.txt, ml5h_meta.json, meta.txt, calibration.json) —
#     без meta.txt и calibration.json бот стартует БЕЗ второго
#     контролёра и БЕЗ проверки честного шанса (напишет об этом в логе).

# ============================================================
# 1. КЛЮЧИ БИРЖИ BINANCE (фьючерсы)
# ============================================================
# Создаются на Binance в разделе API Management:
#   - права: только "Enable Futures" (торговля);
#   - право "Enable Withdrawals" НЕ включать никогда;
#   - ограничение по IP: вписать адрес сервера, где стоит бот.
# Если ключ утечёт — без права вывода и с чужого IP им нельзя
# забрать деньги.
API_KEY=
API_SECRET=

# ============================================================
# 2. ГДЕ ТОРГУЕМ
# ============================================================
# mainnet = настоящая биржа и настоящие деньги.
# demo    = учебная биржа с виртуальными деньгами.
# В бою стоит mainnet; demo — только для экспериментов.
BOT_MODE=mainnet

# Сухой режим: бот делает ВСЁ (считает, показывает, готовит ордера),
# но ордера на биржу не отправляет. Ступень проверки перед деньгами.
# 1 = включено (ничего не торгует), 0 = выключено (торгует по-настоящему).
BOT_DRY_RUN=0

# ============================================================
# 3. TELEGRAM — куда приходят сообщения о сделках и тревоги
# ============================================================
# Токен бота (от @BotFather) и номер чата (узнать у @userinfobot).
# Пусто = работать без уведомлений.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# 4. БУРЯ — главный торговый двигатель (модель на 5 часов)
# ============================================================
# Включён ли двигатель. 1 = работает, 0 = выключен полностью.
ML5H_ENABLED=1

# Список монет через запятую (например BTCUSDT,ETHUSDT).
# ПУСТО = берётся весь список из паспорта модели (~515 монет USDT).
# Обычно оставляем пустым — модель сама знает свою вселенную.
ML5H_SYMBOLS=

# Сколько позиций может быть открыто одновременно.
# 10 позиций × 5% баланса маржи = ровно половина баланса в работе.
ML5H_MAX_SLOTS=10

# Мета — второй контролёр. Она помнит, чем кончались похожие
# сигналы Бури раньше, и запрещает вход, если раньше такие
# теряли. Решение владельца: мета включена ВСЕГДА.
# 1 = включена, 0 = бот торгует без этого контроля.
ML5H_META=1

# Настоящий шанс для входа. Уверенность Бури в сыром виде
# завышена (говорит 65% — сбывается в ~56%). Карта калибровки
# переводит «сказанное» в «реально сбывается». Вход разрешён
# только когда РЕАЛЬНЫЙ шанс >= этого числа.
# 0.60 = вход при настоящем шансе 60% и выше.
ML5H_GATE_TRUE=0.60

# Фильтр «тихая треть»: сонь-монеты с низкой волатильностью
# мимо — торговля разрешена только трети самых подвижных монет
# на каждый момент. 1 = включён, 0 = выключен.
ML5H_QUIET_FILTER=1

# Если входная заявка не исполнилась за отведённое время:
# 0 = сигнал пропускается (в бою так — вход строго своей ценой,
# никакой погони за рынком);
# 1 = докупать по рынку (на демо-бирже нет ликвидности под
# лимитки, поэтому там включали). В бою держать 0.
ML5H_TAKER_FALLBACK=0

# ============================================================
# 5. РАЗМЕР ПОЗИЦИИ (схема владельца от 02.11)
# ============================================================
# Как считается размер одной сделки:
#   баланс × половина (50%) × плечо (3) × 10% = 15% баланса
#   номиналом; 10 позиций = ровно половина баланса в работе.
#   Если у монеты минимальный ордер больше — размер поднимается
#   до минимума × 1.1 (иначе сделка запрещена).
#
# Два ключа ниже — старая схема «риск в долларах на сделку».
# 0 = не используются, размер считается процентом от баланса.
# Трогать не нужно.
ML5H_RISK_USDC=0

# Дневной стоп-лосс: если за день просадка достигла этой цифры —
# новые входы запрещены до полуночи. 0 = считать процентом:
# 4% от баланса (пример: при 120 на счету это ~4.8).
ML5H_DAY_CAP_USDC=0

# ============================================================
# 6. ДВИГАТЕЛЬ «СТАКАН» — второй двигатель (ВЫКЛЮЧЕН в бою)
# ============================================================
# Работал со стаканом заявок на коротких сделках. 27.10 решено:
# выключен и не используется. 0 = спит (файлы сохранены как запас).
LOB_ENABLED=0
# Монеты стакана (пусто = все USDC-пары биржи).
LOB_SYMBOLS=
# Размер сделки и дневной кап стакана — пока он спит, значения
# не действуют. При включении: пересмотреть.
LOB_RISK_USDC=0
LOB_DAY_CAP_USDC=0

# ============================================================
# 7. СЛУЖЕБНЫЕ — обычно трогать не нужно
# ============================================================
# Прокси для всех обращений к бирже. Нужен ТОЛЬКО если сервер
# ходит в интернет через плавающий адрес (белый список IP
# становится рулеткой). Формат: http://user:pass@host:port
# ПУСТО = ходим напрямую с адреса сервера (наш случай).
EXEC_PROXY=

# Куда писать журнал работы. По умолчанию data/bot.log внутри
# контейнера. Менять не нужно.
# BOT_LOG_PATH=
