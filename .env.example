# Копировать в .env и заполнить реальными ключами!
API_KEY=ваш_ключ
API_SECRET=ваш_секрет

# Режим: demo | testnet | mainnet  (ДЕМО по умолчанию!)
BOT_MODE=demo

# Стратегия
BOT_TARGET_PCT=0.005      # цель одной сделки, доля цены (+0.5%)

# Сайзинг (рейт-нормированный):
# размер = баланс x BOT_RISK_PCT / дистанция стопа, зажат между
# полом (minNotional монеты x BOT_NOTIONAL_BUFFER) и BOT_MAX_NOTIONAL
BOT_RISK_PCT=0.0015       # риск на один сработавший стоп: 0.15% баланса
BOT_MAX_NOTIONAL=1500     # потолок нотионала одной позиции, USDC
BOT_NOTIONAL_BUFFER=1.1   # буфер над minNotional (запас на округления)

# Дневной лимит убытка НА НАПРАВЛЕНИЕ (доля баланса): когда дневной убыток
# лонгов (или шортов) достигает порога, новые входы этой стороны приостанавливаются
# до суточного сброса. Противоположная сторона продолжает торговать (развороты не пропускает)
BOT_DAILY_LOSS_PCT=0.02    # 2% баланса на направление за день

# Плечо и пробный прогон
BOT_LEVERAGE=20           # изолированное плечо (запас до ликвидации)
BOT_DRY_RUN=1             # 1 = только сигналы в журнал, ордера не ставятся

# Список пар через запятую (пусто = все USDC-пары биржи)
BOT_SYMBOLS=
