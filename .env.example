# ПРИМЕР ОКРУЖЕНИЯ unified-real (актуализировано 02.11.2026).
# Скопировать в .env и заполнить. В git не попадает (.gitignore).

# --- Биржа: ключ только с торговыми правами, БЕЗ права вывода, IP-whitelist ---
API_KEY=
API_SECRET=

# --- Режим: mainnet = боевой (реальные деньги) ---
BOT_MODE=mainnet
BOT_DRY_RUN=0

# --- Telegram: сделки, аудит, тревоги (пусто = без уведомлений) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Буря (ML-5ч) — единственный боевой двигатель ---
ML5H_ENABLED=1
# вселенная: пусто = все живые USDT-перпетуалы (авто с биржи, ~515)
ML5H_SYMBOLS=
# максимум одновременных позиций
ML5H_MAX_SLOTS=12
# мета-замок: вето при p_win<0.5 (решение владельца 01.11: ВСЕГДА включена)
ML5H_META=1
# фильтр «тихая треть»: сонные монеты мимо
ML5H_QUIET_FILTER=1
# вход тейкером, если лимитка не взялась за TTL (бою не нужно)
ML5H_TAKER_FALLBACK=0

# --- Сайзинг (схема владельца 02.11) ---
# номинал = 10% баланса, пол = мин-ордер МОНЕТЫ × 1.1 (в коде config.py)
# Два ключа ниже — legacy старого сайзинга; 0 = не используются:
ML5H_RISK_USDC=0
# дневной кап: 0 = чистый процент daily_cap_pct = 4% баланса (config.py)
ML5H_DAY_CAP_USDC=0

# --- Двигатель «Стакан» (lob): выключен в бою (упрощение 27.10) ---
LOB_ENABLED=0
LOB_SYMBOLS=
LOB_RISK_USDC=0.10
LOB_DAY_CAP_USDC=0.50
